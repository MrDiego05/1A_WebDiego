---
// RightSidebar.astro — Floating vertical accessibility and scroll control bar
---

<!-- Floating Right Sidebar -->
<aside
  id="floating-sidebar"
  class="floating-sidebar"
  aria-label="Controles globales y accesibilidad"
>
  <!-- Top Icons: Global Controls -->
  <div class="sidebar-top">
    <!-- Modo Oscuro (Luna creciente) -->
  </div>

  <!-- Center: Barra de Progreso de Desplazamiento (Scroll Progress Bar) -->
  <div
    class="sidebar-track-container"
    title="Progreso de lectura"
    aria-hidden="true"
  >
    <div class="sidebar-track">
      <div id="sidebar-scroll-thumb" class="sidebar-thumb"></div>
    </div>
  </div>

  <!-- Bottom: Scroll Down Icon (Círculo discontinuo con flecha hacia abajo) -->
  <div class="sidebar-bottom">
    <button
      id="sidebar-scroll-down"
      class="sidebar-scroll-btn"
      title="Desplazarse hacia abajo"
      aria-label="Desplazarse a la siguiente sección"
      onclick="scrollNextSection()"
    >
      <span class="scroll-arrow">↓</span>
    </button>
  </div>
</aside>

<!-- Menú de Accesibilidad Avanzado (Panel lateral superpuesto) -->
<div
  id="a11y-advanced-panel"
  class="a11y-advanced-panel"
  role="dialog"
  aria-modal="true"
  aria-label="Panel de Accesibilidad Universal"
  hidden
>
  <div class="a11y-panel-header">
    <div class="a11y-panel-title-wrap">
      <svg
        class="a11y-title-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
      >
        <circle cx="12" cy="5" r="2"></circle>
        <path d="m9 20 3-6 3 6"></path>
        <path d="m6 8 6 2 6-2"></path>
        <path d="M12 10v4"></path>
      </svg>
      <h3>Accesibilidad Universal</h3>
    </div>
    <button
      class="a11y-panel-close"
      onclick="toggleA11yPanel()"
      aria-label="Cerrar panel">✕</button
    >
  </div>

  <div class="a11y-panel-body">
    <!-- CONTROL 1: Texto a Voz / Lector de Pantalla -->
    <div class="a11y-control-card">
      <div class="a11y-control-head">
        <div class="a11y-icon-pill">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
            <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
            <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
          </svg>
        </div>
        <div class="a11y-control-info">
          <h4>Lector de Pantalla (Texto a Voz)</h4>
          <p>Lee el contenido en español</p>
        </div>
      </div>

      <div class="a11y-speech-actions">
        <button
          id="btn-toggle-speech"
          class="a11y-action-btn primary"
          onclick="toggleSpeech()"
        >
          <span id="speech-btn-icon">▶</span>
          <span id="speech-btn-text">Escuchar página</span>
        </button>
      </div>

      <div class="a11y-speech-settings">
        <label class="a11y-field">
          <span>Velocidad de Lectura</span>
          <select id="a11y-speech-speed" onchange="updateSpeechSettings()">
            <option value="0.5">0.5x (Lenta)</option>
            <option value="1.0" selected>1.0x (Normal)</option>
            <option value="1.5">1.5x (Rápida)</option>
            <option value="2.0">2.0x (Muy rápida)</option>
          </select>
        </label>

        <label class="a11y-field">
          <span>Tono de Voz</span>
          <select id="a11y-speech-pitch" onchange="updateSpeechSettings()">
            <option value="0.8">Grave</option>
            <option value="1.0" selected>Normal</option>
            <option value="1.3">Agudo</option>
          </select>
        </label>
      </div>
    </div>

    <!-- CONTROL 2: Modo de Enfoque -->
    <div class="a11y-control-card">
      <div class="a11y-control-head">
        <div class="a11y-icon-pill">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <circle cx="12" cy="12" r="6"></circle>
            <circle cx="12" cy="12" r="2"></circle>
          </svg>
        </div>
        <div class="a11y-control-info">
          <h4>Modo de Enfoque</h4>
          <p>Oscurece el fondo y resalta la lectura activa</p>
        </div>
      </div>
      <button
        id="btn-focus-mode"
        class="a11y-toggle-btn"
        onclick="toggleFocusMode()"
      >
        <span class="toggle-indicator"></span>
        <span id="focus-mode-label">Activar Modo Enfoque</span>
      </button>
    </div>

    <!-- CONTROL 3: Contraste Alto -->
    <div class="a11y-control-card">
      <div class="a11y-control-head">
        <div class="a11y-icon-pill">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <circle cx="12" cy="12" r="10"></circle>
            <path d="M12 2a10 10 0 0 1 0 20Z"></path>
          </svg>
        </div>
        <div class="a11y-control-info">
          <h4>Contraste Alto</h4>
          <p>Máximo contraste para legibilidad</p>
        </div>
      </div>
      <button
        id="btn-high-contrast"
        class="a11y-toggle-btn"
        onclick="toggleHighContrast()"
      >
        <span class="toggle-indicator"></span>
        <span id="contrast-label">Activar Alto Contraste</span>
      </button>
    </div>

    <!-- CONTROL 4: Aumentar Tamaño de Fuente -->
    <div class="a11y-control-card">
      <div class="a11y-control-head">
        <div class="a11y-icon-pill">
          <span style="font-weight: 800; font-size: 14px;">Aa</span>
        </div>
        <div class="a11y-control-info">
          <h4>Tamaño de Fuente</h4>
          <p>Ajuste proporcional en vivo</p>
        </div>
      </div>
      <div class="a11y-font-controls">
        <button
          class="a11y-step-btn"
          onclick="adjustFontSize(-1)"
          title="Reducir fuente">A−</button
        >
        <span id="font-size-display" class="font-size-display">100%</span>
        <button
          class="a11y-step-btn"
          onclick="adjustFontSize(1)"
          title="Aumentar fuente">A+</button
        >
      </div>
    </div>

    <!-- CONTROL 5: Fuente Apta para Dislexia -->
    <div class="a11y-control-card">
      <div class="a11y-control-head">
        <div class="a11y-icon-pill">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          >
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path>
            <path
              d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"
            ></path>
          </svg>
        </div>
        <div class="a11y-control-info">
          <h4>Fuente Apta para Dislexia</h4>
          <p>Tipografía y espaciado de alta legibilidad</p>
        </div>
      </div>
      <button
        id="btn-dyslexia-font"
        class="a11y-toggle-btn"
        onclick="toggleDyslexiaFont()"
      >
        <span class="toggle-indicator"></span>
        <span id="dyslexia-label">Activar Fuente Dislexia</span>
      </button>
    </div>
  </div>
</div>

<!-- Focus Mode Dim Backdrop -->
<div id="focus-backdrop" class="focus-backdrop" aria-hidden="true"></div>
