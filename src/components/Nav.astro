---
// Nav.astro — Full-width fixed header navigation bar matching screenshot layout
---

<header class="nav-container" id="nav-container">
  <nav
    id="main-nav"
    class="floating-capsule-nav"
    aria-label="Navegación principal del portfolio"
  >
    <!-- Bloque 1: Inicio -->
    <a
      href="#inicio"
      class="nav-pill pill-inicio"
      aria-current="page"
      id="nav-link-inicio"
    >
      INICIO
    </a>

    <!-- Bloque 2: Sobre Mí -->
    <a
      href="#sobre-mi"
      class="nav-pill pill-sobre"
      id="nav-link-sobre"
    >
      SOBRE MÍ
    </a>

    <!-- Bloque 3: Experiencia (Resaltado en Naranja vibrante) -->
    <a
      href="#experiencia"
      class="nav-pill pill-exp"
      id="nav-link-exp"
    >
      EXPERIENCIA
    </a>

    <!-- Bloque 4: Proyectos (Borde punteado/dashed) -->
    <a
      href="/proyectos"
      class="nav-pill pill-proyectos"
      id="nav-link-proyectos"
      title="Descubre los proyectos"
    >
      DESCUBRE LOS PROYECTOS
    </a>

    <!-- Bloque 5: Contacto (Botón negro largo) -->
    <a
      href="#contacto"
      class="nav-pill pill-contacto"
      id="nav-link-contacto"
    >
      CONTACTO
    </a>

    <!-- Acciones Globales: Modo Oscuro + Accesibilidad -->
    <button
      id="sidebar-dark-toggle"
      class="sidebar-btn"
      title="Cambiar Modo Oscuro / Claro"
      aria-label="Alternar modo oscuro y claro"
      onclick="toggleDark()"
    >
      <svg
        class="sidebar-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>

    <button
      id="sidebar-a11y-toggle"
      class="sidebar-btn sidebar-btn-highlight"
      title="Accesibilidad Universal"
      aria-label="Abrir panel de accesibilidad universal"
      aria-expanded="false"
      onclick="toggleA11yPanel()"
    >
      <svg
        class="sidebar-icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="5" r="2"></circle>
        <path d="m9 20 3-6 3 6"></path>
        <path d="m6 8 6 2 6-2"></path>
        <path d="M12 10v4"></path>
      </svg>
      <span class="a11y-badge-pulse" aria-hidden="true"></span>
    </button>
  </nav>
</header>
