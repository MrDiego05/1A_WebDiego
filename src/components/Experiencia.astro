---
// Experiencia.astro — Experience and technologies section
---

<section
  id="experiencia"
  class="snap-section"
  data-contrast="light"
  data-title="EXPERIENCIA"
>
  <div class="sec-header">
    <span class="sec-num">01</span>
    <h2 class="sec-title">Experiencia</h2>
    <div class="sec-rule"></div>
  </div>

  <div class="experiencia-layout-grid">
    <div class="exp-grid">
      <div class="exp-item">
        <div class="exp-dates">2022<br />—<br />presente</div>
        <div class="exp-body">
          <p class="exp-role">Especialista en Configuración de Plugins</p>
          <p class="exp-company">Práctica profesional</p>
          <p class="exp-desc">
            Implementación, personalización y arquitectura de lógica de servidor
            mediante la configuración de plugins para plataformas de
            entrenamiento/servidores interactivos
          </p>
        </div>
      </div>

      <div class="exp-item">
        <div class="exp-dates">2025</div>
        <div class="exp-body">
          <p class="exp-role">
            Diseñador de Interfaz y Experiencia de Usuario (UI/UX)
          </p>
          <p class="exp-company">Práctica profesional</p>
          <p class="exp-desc">
            Creación de prototipos interactivos, wireframes de alta fidelidad y
            maquetas de interfaz para aplicaciones web y móviles utilizando
            Figma.
          </p>
        </div>
      </div>

      <div class="exp-item">
        <div class="exp-dates">2026</div>
        <div class="exp-body">
          <p class="exp-role">
            Ayudante de Docencia / Mentor de Tecnología para Niños (7–10 años)
          </p>
          <p class="exp-company">Escuela Privada</p>
          <p class="exp-desc">
            Facilitación de sesiones de aprendizaje guiado en fundamentos de
            tecnología y lógica, adaptando conceptos abstractos a metodologías
            lúdicas y accesibles.
          </p>
        </div>
      </div>
    </div>

    <!-- Technologies -->
    <div class="tech-block">
      <p class="tech-label">// TECNOLOGÍAS</p>
      <div class="tech-grid">
        <span class="tech-tag highlight">JavaScript</span>
        <span class="tech-tag highlight">Python</span>
        <span class="tech-tag highlight">HTML / CSS</span>
        <span class="tech-tag">Node.js</span>
        <span class="tech-tag">Git</span>
        <span class="tech-tag">Java</span>
        <span class="tech-tag">Linux</span>
        <span class="tech-tag">Figma</span>
        <span class="tech-tag">Next.js</span>
        <span class="tech-tag">TailwindCSS</span>
      </div>
    </div>
  </div>

  <!-- Stickers anclados a la sección Experiencia -->
  <div class="section-stickers-layer" aria-hidden="true">
    <div
      class="neo-sticker sticker-orange"
      style="top: 14%; left: 74%; --rot: -4deg; transform: rotate(-4deg);"
      data-sticker
    >
      <div class="sticker-inner">
        <img
          draggable="false"
          src="/stickers/726124634c7d9e562aea76e8ea83bf14.png"
          alt="sticker1"
        />
      </div>
    </div>

    <div
      class="neo-sticker sticker-cyan"
      style="top: 80%; left: 70%; --rot: 5deg; transform: rotate(5deg);"
      data-sticker
    >
      <div class="sticker-inner">
        <img
          draggable="false"
          src="/stickers/4b99986bbd4415b20760544d55961309.png"
          alt="sticker1"
        />
      </div>
    </div>
  </div>
</section>
