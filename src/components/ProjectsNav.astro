---
// ProjectsNav.astro — Exclusive independent navigation menu for Projects
---

<header class="nav-container projects-nav-container" id="nav-container">
  <nav
    id="projects-main-nav"
    class="floating-capsule-nav"
    aria-label="Navegación exclusiva de proyectos"
  >
    <!-- Botón Volver al Portfolio (Inicio) -->
    <a
      href="/"
      class="nav-pill pill-inicio pill-back-home"
      id="nav-link-back-home"
      title="Volver a la página principal"
    >
      INICIO
    </a>

    <!-- Contacto o GitHub directo -->
    <a
      href="https://github.com/MrDiego05"
      target="_blank"
      rel="noopener"
      class="nav-pill pill-proyectos"
      id="nav-link-proj-github"
    >
      GITHUB ↗
    </a>

    <!-- Controles Globales: Modo Oscuro + A11y -->
    <div class="nav-controls-group">
      <button
        id="sidebar-dark-toggle"
        class="sidebar-btn"
        title="Cambiar Modo Oscuro / Claro"
        aria-label="Alternar modo oscuro y claro"
        onclick="toggleDark()"
      >
        <svg
          class="sidebar-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <button
        id="sidebar-a11y-toggle"
        class="sidebar-btn sidebar-btn-highlight"
        title="Accesibilidad Universal"
        aria-label="Abrir panel de accesibilidad universal"
        aria-expanded="false"
        onclick="toggleA11yPanel()"
      >
        <svg
          class="sidebar-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <circle cx="12" cy="5" r="2"></circle>
          <path d="m9 20 3-6 3 6"></path>
          <path d="m6 8 6 2 6-2"></path>
          <path d="M12 10v4"></path>
        </svg>
        <span class="a11y-badge-pulse" aria-hidden="true"></span>
      </button>
    </div>
  </nav>
</header>
