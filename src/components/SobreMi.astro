---
// SobreMi.astro — About me section with education, skills and achievements
---

<section
  id="sobre-mi"
  class="snap-section"
  data-contrast="dark"
  data-title="SOBRE MÍ"
>
  <div class="sec-header">
    <span class="sec-num">02</span>
    <h2 class="sec-title">Acerca de mí</h2>
    <div class="sec-rule"></div>
  </div>

  <div class="sobre-grid">
    <!-- ESTUDIOS -->
    <div class="sobre-col">
      <p class="sobre-col-label">// ESTUDIOS</p>
      <div class="sobre-item">
        <p class="sobre-item-title">Ingeniería en Software</p>
        <p class="sobre-item-sub">UG - Universidad de Guayaquil</p>
        <p class="sobre-item-year">2025 — presente</p>
      </div>
      <div class="sobre-item">
        <p class="sobre-item-title">Bachillerato en Ciencias</p>
        <p class="sobre-item-sub">Unidad Educativa Fiscal Los Vergeles</p>
        <p class="sobre-item-year">2024 — 2025</p>
      </div>
      <div class="sobre-item">
        <p class="sobre-item-title">Ingles</p>
        <p class="sobre-item-sub">Duolingo</p>
        <p class="sobre-item-year">2024-Presente</p>
      </div>
    </div>

    <!-- CONOCIMIENTOS -->
    <div class="sobre-col">
      <p class="sobre-col-label">// CONOCIMIENTOS</p>
      <div class="sobre-item">
        <p class="sobre-item-title">Desarrollo Web Full Stack</p>
        <p class="sobre-item-sub">
          Frontend y backend, diseño de APIs, gestión de bases de datos.
        </p>
      </div>
      <div class="sobre-item">
        <p class="sobre-item-title">Inteligencia Artificial</p>
        <p class="sobre-item-sub">
          Machine learning supervisado, procesamiento de datos, NLP básico.
        </p>
      </div>
      <div class="sobre-item">
        <p class="sobre-item-title">DevOps básico</p>
        <p class="sobre-item-sub">
          Docker, CI/CD, manejo de entornos y despliegue en la nube.
        </p>
      </div>
      <div class="sobre-item">
        <p class="sobre-item-title">Metodologías ágiles</p>
        <p class="sobre-item-sub">
          Scrum, trabajo en equipo, comunicación técnica.
        </p>
      </div>
    </div>

    <!-- LOGROS -->
    <div class="sobre-col">
      <p class="sobre-col-label">// LOGROS Y RECONOCIMIENTOS</p>
      <div class="logro-item">
        <span class="logro-icon">◆</span>
        <div class="logro-text">
          <strong>Bachillerato en Ciencias</strong>
          Graduación exitosa como bachiller en ciencias en la Unidad Edicativa Los
          Vergeles.
        </div>
      </div>
      <div class="logro-item">
        <span class="logro-icon">◆</span>
        <div class="logro-text">
          <strong>Excelencia académica</strong>
          Reconocimiento por rendimiento en los Ultimos años electivos.
        </div>
      </div>
      <div class="logro-item">
        <span class="logro-icon">◆</span>
        <div class="logro-text">
          <strong>Evento en Juegos </strong>
          Participé en la organización de mi primer evento de desarrollo dentro de
          un videojuegos con creadores de toda Latinoamérica..
        </div>
      </div>
    </div>
  </div>

  <!-- Stickers anclados a la sección Sobre Mí -->
  <div class="section-stickers-layer" aria-hidden="true">
    <div
      class="neo-sticker sticker-purple"
      style="top: 14%; left: 78%; --rot: 5deg; transform: rotate(5deg);"
      data-sticker
    >
      <div class="sticker-inner">
        <img
          draggable="false"
          src="/public/stickers/ddeb9a0e427dfb83b9fb3e3cf093dde7.png"
          alt="sticker1"
        />
      </div>
    </div>

    <div
      class="neo-sticker sticker-green"
      style="top: 80%; left: 82%; --rot: -4deg; transform: rotate(-4deg);"
      data-sticker
    >
      <div class="sticker-inner">
        <img
          draggable="false"
          src="/public/stickers/726124634c7d9e562aea76e8ea83bf14.png"
          alt="sticker1"
        />
      </div>
    </div>
  </div>
</section>
