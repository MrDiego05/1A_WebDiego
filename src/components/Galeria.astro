---
// Galeria.astro — Fullscreen Horizontal Project Slides (100vw x 100vh)
---

<!-- PROYECTO 001: Web UI/UX Concept -->
<section
  class="snap-section project-slide"
  id="proyectos"
  data-project="1"
  data-title="PROYECTO 001"
>
  <div class="project-slide-inner">
    <div class="project-top-meta">
      <div class="project-badge">PROYECTO DESTACADO · 01 / 03</div>
      <div class="project-category-pill">UI / UX DESIGN</div>
    </div>

    <div class="project-main-grid">
      <!-- Left info -->
      <div class="project-info-col">
        <span class="project-giant-num">001</span>
        <h2 class="project-title">Diseño Web UI/UX</h2>
        <p class="project-lead">
          Concepto e interfaz web moderna e interactiva diseñada en Figma.
        </p>
        <p class="project-desc">
          Prototipo de alta fidelidad centrado en la experiencia de usuario (UX)
          y arquitectura visual. Incluye diseño responsivo, definición de
          componentes reutilizables, paleta cromática optimizada y flujos de
          navegación intuitivos para aplicaciones web.
        </p>

        <div class="project-tags">
          <span class="proy-tag">Figma</span>
          <span class="proy-tag">UI/UX</span>
          <span class="proy-tag">Wireframing</span>
          <span class="proy-tag">Prototyping</span>
          <span class="proy-tag">Design System</span>
        </div>

        <div class="project-actions">
          <a
            href="https://github.com/MrDiego05"
            target="_blank"
            rel="noopener"
            class="project-btn primary"
          >
            <span>Ver Demo</span>
            <span class="btn-arrow">↗</span>
          </a>
          <a
            href="https://github.com/MrDiego05"
            target="_blank"
            rel="noopener"
            class="project-btn secondary"
          >
            <span>Código GitHub</span>
            <span class="btn-arrow">&lt;/&gt;</span>
          </a>
        </div>
      </div>

      <!-- Right Mockup / Preview frame -->
      <div class="project-preview-col">
        <div class="mockup-window">
          <div class="mockup-header">
            <div class="mockup-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <div class="mockup-url">figma.com/file/web-design-concept</div>
          </div>
          <div class="mockup-canvas">
            <div class="mockup-placeholder">
              <div class="mockup-badge-live">FIGMA PROTOTYPE</div>
              <div class="mockup-icon-large">🎨</div>
              <h3 class="mockup-preview-title">Prototipo Interactivo Figma</h3>
              <p class="mockup-preview-sub">
                Diseño de interfaz de usuario enfocado en usabilidad y estética
                moderna
              </p>
              <div class="mockup-stats-bar">
                <div class="stat-box">
                  <span class="stat-num">100%</span><span class="stat-label"
                    >Vectorial</span>
                </div>
                <div class="stat-box">
                  <span class="stat-num">UI/UX</span><span class="stat-label"
                    >Enfoque</span>
                </div>
                <div class="stat-box">
                  <span class="stat-num">Figma</span><span class="stat-label"
                    >Herramienta</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stickers anclados a Proyecto 001 -->
  <div class="section-stickers-layer" aria-hidden="true">
    <div
      class="neo-sticker sticker-green"
      style="top: 14%; left: 74%; --rot: -4deg; transform: rotate(-4deg);"
      data-sticker
    >
      <div class="sticker-inner">
        <span class="sticker-emoji">🎨</span>
        <span class="sticker-text">UI/UX DESIGN</span>
      </div>
    </div>
    <div
      class="neo-sticker sticker-orange"
      style="top: 82%; left: 78%; --rot: 5deg; transform: rotate(5deg);"
      data-sticker
    >
      <div class="sticker-inner">
        <span class="sticker-emoji">✨</span>
        <span class="sticker-text">FIGMA CONCEPT</span>
      </div>
    </div>
  </div>
</section>

<!-- PROYECTO 002: In-Game LATAM Event -->
<section
  class="snap-section project-slide"
  id="proyecto-002"
  data-project="2"
  data-title="PROYECTO 002"
>
  <div class="project-slide-inner">
    <div class="project-top-meta">
      <div class="project-badge">PROYECTO DESTACADO · 02 / 03</div>
      <div class="project-category-pill">GAMING & EVENTS</div>
    </div>

    <div class="project-main-grid">
      <div class="project-info-col">
        <span class="project-giant-num">002</span>
        <h2 class="project-title">Evento Interactivo en Videojuego</h2>
        <p class="project-lead">
          Coorganización y desarrollo de un evento competitivo multijugador con
          alcance internacional.
        </p>
        <p class="project-desc">
          Gestión técnica, logística y desarrollo de mecánicas personalizadas
          dentro de un entorno de juego online para un torneo latinoamericano.
          Participaron 30 competidores por un premio, asegurando baja latencia,
          moderación en tiempo real y flujo continuo del evento.
        </p>

        <div class="project-tags">
          <span class="proy-tag">Plugin Config</span>
          <span class="proy-tag">Game Hosting</span>
          <span class="proy-tag">Community Management</span>
          <span class="proy-tag">Real-Time Events</span>
        </div>

        <div class="project-actions">
          <a
            href="https://github.com/MrDiego05"
            target="_blank"
            rel="noopener"
            class="project-btn primary"
          >
            <span>Ver Demo</span>
            <span class="btn-arrow">↗</span>
          </a>
          <a
            href="https://github.com/MrDiego05"
            target="_blank"
            rel="noopener"
            class="project-btn secondary"
          >
            <span>Código GitHub</span>
            <span class="btn-arrow">&lt;/&gt;</span>
          </a>
        </div>
      </div>

      <div class="project-preview-col">
        <div class="mockup-window">
          <div class="mockup-header">
            <div class="mockup-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <div class="mockup-url">event.latam-gaming.net</div>
          </div>
          <div class="mockup-canvas">
            <div class="mockup-placeholder">
              <div class="mockup-badge-live">LIVE COMPETITION</div>
              <div class="mockup-icon-large">🎮</div>
              <h3 class="mockup-preview-title">
                Torneo Latinoamericano en Vivo
              </h3>
              <p class="mockup-preview-sub">
                Coordinación en tiempo real y gestión de 30 participantes
                simultáneos
              </p>
              <div class="mockup-stats-bar">
                <div class="stat-box">
                  <span class="stat-num">30</span><span class="stat-label"
                    >Jugadores</span>
                </div>
                <div class="stat-box">
                  <span class="stat-num">LATAM</span><span class="stat-label"
                    >Comunidad</span>
                </div>
                <div class="stat-box">
                  <span class="stat-num">100%</span><span class="stat-label"
                    >Uptime</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PROYECTO 003: Hotel Reservation System -->
<section
  class="snap-section project-slide"
  id="proyecto-003"
  data-project="3"
  data-title="PROYECTO 003"
>
  <div class="project-slide-inner">
    <div class="project-top-meta">
      <div class="project-badge">PROYECTO DESTACADO · 03 / 03</div>
      <div class="project-category-pill">JAVA & OOP</div>
    </div>

    <div class="project-main-grid">
      <div class="project-info-col">
        <span class="project-giant-num">003</span>
        <h2 class="project-title">Sistema de Reserva de Hotel</h2>
        <p class="project-lead">
          Sistema de gestión de habitaciones y recepciones impulsado por
          Programación Orientada a Objetos.
        </p>
        <p class="project-desc">
          Proyecto integrador desarrollado bajo los principios de POO (herencia,
          polimorfismo y encapsulamiento). Permite a los recepcionistas
          gestionar reservas, verificar disponibilidad de habitaciones en tiempo
          real, procesar check-in/check-out y administrar clientes de forma
          eficiente.
        </p>

        <div class="project-tags">
          <span class="proy-tag">Java</span>
          <span class="proy-tag">POO</span>
          <span class="proy-tag">CRUD</span>
          <span class="proy-tag">Software Architecture</span>
        </div>

        <div class="project-actions">
          <a
            href="https://github.com/MrDiego05"
            target="_blank"
            rel="noopener"
            class="project-btn primary"
          >
            <span>Ver Demo</span>
            <span class="btn-arrow">↗</span>
          </a>
          <a
            href="https://github.com/MrDiego05"
            target="_blank"
            rel="noopener"
            class="project-btn secondary"
          >
            <span>Código GitHub</span>
            <span class="btn-arrow">&lt;/&gt;</span>
          </a>
        </div>
      </div>

      <div class="project-preview-col">
        <div class="mockup-window">
          <div class="mockup-header">
            <div class="mockup-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <div class="mockup-url">hotel-manager.local/dashboard</div>
          </div>
          <div class="mockup-canvas">
            <div class="mockup-placeholder">
              <div class="mockup-badge-live">DESKTOP SYSTEM</div>
              <div class="mockup-icon-large">🏨</div>
              <h3 class="mockup-preview-title">
                Panel de Control para Recepción
              </h3>
              <p class="mockup-preview-sub">
                Gestión completa de estados de habitaciones y registro de
                huéspedes
              </p>
              <div class="mockup-stats-bar">
                <div class="stat-box">
                  <span class="stat-num">POO</span><span class="stat-label"
                    >Paradigma</span>
                </div>
                <div class="stat-box">
                  <span class="stat-num">CRUD</span><span class="stat-label"
                    >Módulos</span>
                </div>
                <div class="stat-box">
                  <span class="stat-num">Java</span><span class="stat-label"
                    >Lenguaje</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
