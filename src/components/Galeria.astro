---
// Galeria.astro — Fullscreen Horizontal Project Slides (100vw x 100vh)
---

<!-- PROYECTO 001: GestorEco -->
<section class="snap-section project-slide" id="proyectos" data-project="1" data-title="PROYECTO 001">
  <div class="project-slide-inner">
    <div class="project-top-meta">
      <div class="project-badge">PROYECTO DESTACADO · 01 / 04</div>
      <div class="project-category-pill">WEB & IoT</div>
    </div>

    <div class="project-main-grid">
      <!-- Left info -->
      <div class="project-info-col">
        <span class="project-giant-num">001</span>
        <h2 class="project-title">GestorEco</h2>
        <p class="project-lead">Sistema IoT para optimización de residuos urbanos con métricas en tiempo real.</p>
        <p class="project-desc">
          Plataforma completa para gestión inteligente de contenedores de basura urbanos. Incluye telemetría mediante sensores ultrasónicos, mapa en vivo de rutas de recolección y alertas preventivas vía WebSockets para operarios municipales.
        </p>

        <div class="project-tags">
          <span class="proy-tag">React</span>
          <span class="proy-tag">Node.js</span>
          <span class="proy-tag">IoT</span>
          <span class="proy-tag">Socket.io</span>
          <span class="proy-tag">PostgreSQL</span>
        </div>

        <div class="project-actions">
          <a href="https://github.com/MrDiego05" target="_blank" rel="noopener" class="project-btn primary">
            <span>Ver Demo</span>
            <span class="btn-arrow">↗</span>
          </a>
          <a href="https://github.com/MrDiego05" target="_blank" rel="noopener" class="project-btn secondary">
            <span>Código GitHub</span>
            <span class="btn-arrow">&lt;/&gt;</span>
          </a>
        </div>
      </div>

      <!-- Right Mockup / Preview frame -->
      <div class="project-preview-col">
        <div class="mockup-window">
          <div class="mockup-header">
            <div class="mockup-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <div class="mockup-url">gestoreco-iot.app/dashboard</div>
          </div>
          <div class="mockup-canvas">
            <div class="mockup-placeholder">
              <div class="mockup-badge-live">LIVE TELEMETRY</div>
              <div class="mockup-icon-large">◎</div>
              <h3 class="mockup-preview-title">Dashboard Operativo en Vivo</h3>
              <p class="mockup-preview-sub">Monitoreo de 48 estaciones IoT con telemetría en tiempo real</p>
              <div class="mockup-stats-bar">
                <div class="stat-box"><span class="stat-num">98.4%</span><span class="stat-label">Eficiencia</span></div>
                <div class="stat-box"><span class="stat-num">48</span><span class="stat-label">Sensores</span></div>
                <div class="stat-box"><span class="stat-num">&lt; 100ms</span><span class="stat-label">Latencia</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Stickers anclados a Proyecto 001 -->
  <div class="section-stickers-layer" aria-hidden="true">
    <div class="neo-sticker sticker-green" style="top: 14%; left: 74%; --rot: -4deg; transform: rotate(-4deg);" data-sticker>
      <div class="sticker-inner">
        <span class="sticker-emoji">🌐</span>
        <span class="sticker-text">IoT ECOSYSTEM</span>
      </div>
    </div>
    <div class="neo-sticker sticker-orange" style="top: 82%; left: 78%; --rot: 5deg; transform: rotate(5deg);" data-sticker>
      <div class="sticker-inner">
        <span class="sticker-emoji">⚡</span>
        <span class="sticker-text">REAL-TIME</span>
      </div>
    </div>
  </div>
</section>

<!-- PROYECTO 002: CampusMap -->
<section class="snap-section project-slide" id="proyecto-002" data-project="2" data-title="PROYECTO 002">
  <div class="project-slide-inner">
    <div class="project-top-meta">
      <div class="project-badge">PROYECTO DESTACADO · 02 / 04</div>
      <div class="project-category-pill">MAPS & SVG</div>
    </div>

    <div class="project-main-grid">
      <div class="project-info-col">
        <span class="project-giant-num">002</span>
        <h2 class="project-title">CampusMap</h2>
        <p class="project-lead">Navegación interior para campus universitarios con mapas vectoriales dinámicos.</p>
        <p class="project-desc">
          Aplicación web progresiva diseñada para estudiantes y visitantes de la ESPOL. Permite localizar aulas, laboratorios y auditorios con rutas accesibles paso a paso, integrando capas SVG interactivas y cálculo de distancias.
        </p>

        <div class="project-tags">
          <span class="proy-tag">TypeScript</span>
          <span class="proy-tag">Interactive SVG</span>
          <span class="proy-tag">PostgreSQL</span>
          <span class="proy-tag">TailwindCSS</span>
        </div>

        <div class="project-actions">
          <a href="https://github.com/MrDiego05" target="_blank" rel="noopener" class="project-btn primary">
            <span>Ver Demo</span>
            <span class="btn-arrow">↗</span>
          </a>
          <a href="https://github.com/MrDiego05" target="_blank" rel="noopener" class="project-btn secondary">
            <span>Código GitHub</span>
            <span class="btn-arrow">&lt;/&gt;</span>
          </a>
        </div>
      </div>

      <div class="project-preview-col">
        <div class="mockup-window">
          <div class="mockup-header">
            <div class="mockup-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <div class="mockup-url">campusmap.espol.edu.ec</div>
          </div>
          <div class="mockup-canvas">
            <div class="mockup-placeholder">
              <div class="mockup-badge-live">INDOOR ROUTING</div>
              <div class="mockup-icon-large">🗺</div>
              <h3 class="mockup-preview-title">Navegación Vectorial ESPOL</h3>
              <p class="mockup-preview-sub">Búsqueda inteligente de aulas con rutas punto a punto</p>
              <div class="mockup-stats-bar">
                <div class="stat-box"><span class="stat-num">32</span><span class="stat-label">Edificios</span></div>
                <div class="stat-box"><span class="stat-num">240+</span><span class="stat-label">Aulas</span></div>
                <div class="stat-box"><span class="stat-num">60fps</span><span class="stat-label">SVG Render</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PROYECTO 003: SentimentES -->
<section class="snap-section project-slide" id="proyecto-003" data-project="3" data-title="PROYECTO 003">
  <div class="project-slide-inner">
    <div class="project-top-meta">
      <div class="project-badge">PROYECTO DESTACADO · 03 / 04</div>
      <div class="project-category-pill">AI & DATA</div>
    </div>

    <div class="project-main-grid">
      <div class="project-info-col">
        <span class="project-giant-num">003</span>
        <h2 class="project-title">SentimentES</h2>
        <p class="project-lead">Clasificador de polaridad y análisis de sentimiento en español para redes sociales.</p>
        <p class="project-desc">
          Modelo de procesamiento de lenguaje natural entrenado con más de 50.000 comentarios en español de Ecuador y Latinoamérica. Cuenta con API REST en FastAPI para inferencia ultrarrápida y análisis de métricas de satisfacción.
        </p>

        <div class="project-tags">
          <span class="proy-tag">Python</span>
          <span class="proy-tag">FastAPI</span>
          <span class="proy-tag">NLP</span>
          <span class="proy-tag">scikit-learn</span>
          <span class="proy-tag">Pandas</span>
        </div>

        <div class="project-actions">
          <a href="https://github.com/MrDiego05" target="_blank" rel="noopener" class="project-btn primary">
            <span>Ver Demo</span>
            <span class="btn-arrow">↗</span>
          </a>
          <a href="https://github.com/MrDiego05" target="_blank" rel="noopener" class="project-btn secondary">
            <span>Código GitHub</span>
            <span class="btn-arrow">&lt;/&gt;</span>
          </a>
        </div>
      </div>

      <div class="project-preview-col">
        <div class="mockup-window">
          <div class="mockup-header">
            <div class="mockup-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <div class="mockup-url">api.sentiment-es.ai/docs</div>
          </div>
          <div class="mockup-canvas">
            <div class="mockup-placeholder">
              <div class="mockup-badge-live">NLP INFERENCE</div>
              <div class="mockup-icon-large">🧠</div>
              <h3 class="mockup-preview-title">Sentiment Analysis Pipeline</h3>
              <p class="mockup-preview-sub">Clasificación en tiempo real de polaridad y emociones</p>
              <div class="mockup-stats-bar">
                <div class="stat-box"><span class="stat-num">0.89</span><span class="stat-label">F1-Score</span></div>
                <div class="stat-box"><span class="stat-num">18ms</span><span class="stat-label">Inferencia</span></div>
                <div class="stat-box"><span class="stat-num">50k+</span><span class="stat-label">Dataset</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- PROYECTO 004: DevBoard -->
<section class="snap-section project-slide" id="proyecto-004" data-project="4" data-title="PROYECTO 004">
  <div class="project-slide-inner">
    <div class="project-top-meta">
      <div class="project-badge">PROYECTO DESTACADO · 04 / 04</div>
      <div class="project-category-pill">FULL STACK</div>
    </div>

    <div class="project-main-grid">
      <div class="project-info-col">
        <span class="project-giant-num">004</span>
        <h2 class="project-title">DevBoard</h2>
        <p class="project-lead">Tablero Kanban colaborativo con sincronización en tiempo real y Markdown.</p>
        <p class="project-desc">
          Herramienta ágil orientada a desarrolladores independientes y pequeños equipos. Soporta drag & drop fluido, estados sincronizados instantáneamente con WebSockets, filtros por etiquetas y atajos de teclado completos.
        </p>

        <div class="project-tags">
          <span class="proy-tag">Next.js</span>
          <span class="proy-tag">WebSockets</span>
          <span class="proy-tag">MongoDB</span>
          <span class="proy-tag">Redis</span>
          <span class="proy-tag">Docker</span>
        </div>

        <div class="project-actions">
          <a href="https://github.com/MrDiego05" target="_blank" rel="noopener" class="project-btn primary">
            <span>Ver Demo</span>
            <span class="btn-arrow">↗</span>
          </a>
          <a href="https://github.com/MrDiego05" target="_blank" rel="noopener" class="project-btn secondary">
            <span>Código GitHub</span>
            <span class="btn-arrow">&lt;/&gt;</span>
          </a>
        </div>
      </div>

      <div class="project-preview-col">
        <div class="mockup-window">
          <div class="mockup-header">
            <div class="mockup-dots">
              <span class="dot red"></span>
              <span class="dot yellow"></span>
              <span class="dot green"></span>
            </div>
            <div class="mockup-url">devboard.app/workspace</div>
          </div>
          <div class="mockup-canvas">
            <div class="mockup-placeholder">
              <div class="mockup-badge-live">REALTIME KANBAN</div>
              <div class="mockup-icon-large">☵</div>
              <h3 class="mockup-preview-title">Workspace Ágil Colaborativo</h3>
              <p class="mockup-preview-sub">Sincronización multiusuario en vivo sin recarga</p>
              <div class="mockup-stats-bar">
                <div class="stat-box"><span class="stat-num">0s</span><span class="stat-label">Latencia sync</span></div>
                <div class="stat-box"><span class="stat-num">Markdown</span><span class="stat-label">Soporte</span></div>
                <div class="stat-box"><span class="stat-num">100%</span><span class="stat-label">Offline first</span></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
